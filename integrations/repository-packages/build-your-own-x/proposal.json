      "path": ".pandamonium/setup.py",
      "content": "import hashlib,subprocess,sys,urllib.request,venv\nfrom pathlib import Path\nurl='https://codeload.github.com/Graphify-Labs/graphify/tar.gz/c7ec1082083e3e876443f643ecf86ebcfae177c2'\nwith urllib.request.urlopen(url,timeout=30) as response: data=response.read(8*1024*1024)\nif hashlib.sha256(data).hexdigest()!='9662f9eff349331fef3a41a9731f709b91fd6ddf661eb39c9309a55696a6dc1f': raise RuntimeError('Graphify checksum mismatch')\nPath('/runtime/graphify.tar.gz').write_bytes(data)\nvenv.EnvBuilder(with_pip=True,symlinks=False).create('/runtime/venv')\nsubprocess.run(['/runtime/venv/bin/python','-m','pip','install','--disable-pip-version-check','--no-cache-dir','/runtime/graphify.tar.gz'],check=True,stdout=subprocess.DEVNULL,timeout=240)\nsubprocess.run(['/runtime/venv/bin/python','/package/.pandamonium/graph.py'],check=True,timeout=30)\n"
    },
    {
      "path": ".pandamonium/graph.py",
      "content": "import json\nfrom pathlib import Path\nfrom graphify.extractors.markdown import extract_markdown\nresult=extract_markdown(Path('/package/README.md'))\nPath('/runtime/graph.json').write_text(json.dumps(result))\n"
    }
