      "path": ".pandamonium/setup.py",
      "content": "import subprocess,venv,shutil\nshutil.copytree('/package','/runtime/source',dirs_exist_ok=True)\nvenv.EnvBuilder(with_pip=True,symlinks=False).create('/runtime/venv')\nsubprocess.run(['/runtime/venv/bin/python','-m','pip','install','--disable-pip-version-check','--no-cache-dir','/runtime/source'],check=True,stdout=subprocess.DEVNULL,timeout=240)\n"
    },
    {
      "path": ".pandamonium/adapter.py",
      "content": "import os,sys\nos.execv('/runtime/venv/bin/python',['/runtime/venv/bin/python','/package/.pandamonium/run.py',*sys.argv[1:]])\n"
    },
    {
      "path": ".pandamonium/run.py",
      "content": "import json,sys\nfrom pathlib import Path\nfrom graphify.extractors.markdown import extract_markdown\nargs=json.load(sys.stdin);path=Path(args['path']).resolve()\nif path.suffix.lower() not in {'.md','.markdown'} or not any(path.is_relative_to(Path(root)) for root in ['/package','/runtime/artifacts']):raise ValueError('Choose a Markdown file in /package or /runtime/artifacts')\nif not path.is_file() or path.stat().st_size>1000000:raise ValueError('Markdown source must be a file of at most 1 MB')\nresult=extract_markdown(path);artifact=Path('/runtime/artifacts/graph.json');artifact.write_text(json.dumps(result))\nprint(json.dumps({'nodes':len(result['nodes']),'edges':len(result['edges']),'artifact':str(artifact)}))\n"
    }
  ],
