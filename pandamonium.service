# Copy to /etc/systemd/system/pandamonium.service
# Edit User, WorkingDirectory, and ExecStart paths to match your setup
[Unit]
Description=Pandamonium UI
After=network.target

[Service]
Type=simple
# CHANGE THESE to match your user and install path:
User=YOURUSER
WorkingDirectory=/home/YOURUSER/pandamonium
ExecStart=/home/YOURUSER/pandamonium/venv/bin/uvicorn app:app --port 7000 --host 0.0.0.0
Restart=always
RestartSec=3
EnvironmentFile=-/home/YOURUSER/pandamonium/.env

[Install]
WantedBy=multi-user.target
