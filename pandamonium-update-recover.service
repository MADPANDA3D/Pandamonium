[Unit]
Description=Recover an interrupted Pandamonium release activation
After=network-online.target
Wants=network-online.target
Before=pandamonium.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
EnvironmentFile=/etc/pandamonium/update.env
ExecStart=/opt/pandamonium/current/venv/bin/python /opt/pandamonium/current/scripts/pandamonium-update recover

[Install]
WantedBy=multi-user.target
