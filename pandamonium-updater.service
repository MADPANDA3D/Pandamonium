[Unit]
Description=Apply one owner-approved signed Pandamonium update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
EnvironmentFile=/etc/pandamonium/update.env
ExecStart=/opt/pandamonium/current/venv/bin/python /opt/pandamonium/current/scripts/pandamonium-update apply --request /var/lib/pandamonium/data/updates/request.json

[Install]
WantedBy=multi-user.target
