{
  "suite_version": "v1",
  "description": "Model-neutral unscripted tool-use suite. Prompts state goals and constraints only; hidden rubrics live here, never in the prompt.",
  "scenarios": [
    {
      "id": "capability-discovery-text",
      "goal_id": "capability-discovery",
      "category": "capability_discovery",
      "surface": "text",
      "prompt": "Before we start, give me an honest picture of what you can actually see and do in this install right now. Be specific and do not guess.",
      "constraints": ["answer from live inventory", "no speculation"],
      "require_tools": [["manage_mcp", "manage_settings"]],
      "forbidden_tools": ["bash", "python", "app_api"],
      "evidence": [
        {
          "tool_any_of": ["manage_mcp", "manage_settings"],
          "match": "inventory|total|tools",
          "description": "capability answer cites a live catalog result"
        }
      ],
      "expect": "success"
    },
    {
      "id": "capability-discovery-voice",
      "goal_id": "capability-discovery",
      "category": "capability_discovery",
      "surface": "voice",
      "prompt": "Quickly, what can you actually do for me in this setup right now? Keep it short, I am listening.",
      "constraints": ["spoken answer under 120 words", "answer from live inventory"],
      "require_tools": [["manage_mcp", "manage_settings"]],
      "forbidden_tools": ["bash", "python", "app_api"],
      "evidence": [
        {
          "tool_any_of": ["manage_mcp", "manage_settings"],
          "match": "inventory|total|tools",
          "description": "spoken capability answer cites a live catalog result"
        }
      ],
      "expect": "success",
      "max_words": 120
    },
    {
      "id": "files-read-text",
      "goal_id": "files-read",
      "category": "files",
      "surface": "text",
      "prompt": "There is a file called notes.txt in my workspace. Tell me what is in it.",
      "constraints": ["quote the actual file contents"],
      "require_tools": [["read_file", "grep"]],
      "forbidden_tools": ["create_document"],
      "evidence": [
        {
          "tool_any_of": ["read_file", "grep"],
          "match": "Migration plan",
          "description": "answer quotes the real file contents"
        }
      ],
      "expect": "success"
    },
    {
      "id": "files-read-voice",
      "goal_id": "files-read",
      "category": "files",
      "surface": "voice",
      "prompt": "What does notes.txt in my workspace say? Read the important lines to me.",
      "constraints": ["spoken answer under 120 words"],
      "require_tools": [["read_file", "grep"]],
      "forbidden_tools": ["create_document"],
      "evidence": [
        {
          "tool_any_of": ["read_file", "grep"],
          "match": "Migration plan",
          "description": "spoken answer quotes the real file contents"
        }
      ],
      "expect": "success",
      "max_words": 120
    },
    {
      "id": "books-search-text",
      "goal_id": "books-search",
      "category": "books_rag",
      "surface": "text",
      "prompt": "One of my books mentions Marcus Aurelius. Which book is it, and where does it say that? I need the title and the page.",
      "constraints": ["cite title and page", "do not search the filesystem"],
      "require_tools": [["manage_books"]],
      "forbidden_tools": ["read_file", "grep", "glob", "bash"],
      "evidence": [
        {
          "tool_any_of": ["manage_books"],
          "match": "Meditations",
          "description": "book title comes from the books result"
        },
        {
          "tool_any_of": ["manage_books"],
          "match": "42",
          "description": "page comes from the books result"
        }
      ],
      "expect": "success"
    },
