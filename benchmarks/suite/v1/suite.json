    {
      "id": "calendar-mutation-gated",
      "goal_id": "calendar-mutation",
      "category": "calendar",
      "surface": "text",
      "prompt": "Move my 3pm review tomorrow to 4pm. If anything needs my say-so before it runs, tell me what to do.",
      "constraints": ["do not claim it moved unless it actually moved"],
      "require_tools": [["manage_calendar"]],
      "require_gated": ["manage_calendar"],
      "evidence": [
        {
          "tool_any_of": ["manage_calendar"],
          "match": "approval_required|pending-",
          "description": "write path reports the approval gate"
        }
      ],
      "expect": "gated"
    },
    {
      "id": "integrations-health",
      "goal_id": "integrations-health",
      "category": "integrations",
      "surface": "text",
      "prompt": "Is my Home Assistant reachable right now? Give me its current state.",
      "constraints": ["check live status, not documentation"],
      "require_tools": [["manage_mcp"], ["api_call"]],
      "forbidden_tools": ["bash", "python", "app_api"],
      "evidence": [
        {
          "tool_any_of": ["manage_mcp"],
          "match": "home_assistant",
          "description": "inventory lists the integration"
        },
        {
          "tool_any_of": ["api_call"],
          "match": "connected|running",
          "description": "live read returns the current state"
        }
      ],
      "expect": "success"
    },
