    {
      "id": "failure-recovery",
      "goal_id": "failure-recovery",
      "category": "failure_recovery",
      "surface": "text",
      "prompt": "Read /workspace/quarterly.csv and tell me the Q3 total. If it is not there, find where it went and still get me the number.",
      "constraints": ["do not invent a number"],
      "require_tools": [["read_file"]],
      "evidence": [
        {
          "tool_any_of": ["read_file"],
          "match": "1842",
          "description": "recovered read returns the real total"
        }
      ],
      "expect": "recovery",
      "mock_state": {
        "flaky": {"read_file": {"fail_times": 1, "error": "file not found: /workspace/quarterly.csv"}}
      }
