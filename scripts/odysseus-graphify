#!/usr/bin/env python3
"""Explicit-root Graphify build/status operator CLI."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from src.graphify_runtime import build_command, configured_roots, graph_status  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("list", "status", "build"))
    parser.add_argument("--root-id")
    parser.add_argument("--python", default=sys.executable)
    args = parser.parse_args()
    roots = configured_roots()
    if args.action == "list":
        print(json.dumps({"configured_roots": sorted(roots)}, sort_keys=True))
        return 0
    if not args.root_id or args.root_id not in roots:
        parser.error("--root-id must name one configured root")
    root = roots[args.root_id]
    if args.action == "status":
        print(json.dumps(graph_status(args.root_id, roots), sort_keys=True))
        return 0

    root.output_root.mkdir(parents=True, exist_ok=True)
    environment = {
        key: value
        for key, value in os.environ.items()
        if key in {"HOME", "LANG", "LC_ALL", "PATH", "TMPDIR", "XDG_CACHE_HOME"}
    }
    environment["GRAPHIFY_OUT"] = "graphify-out"
    result = subprocess.run(
        build_command(root, python=args.python),
        cwd=str(root.repository_root),
        env=environment,
        stdin=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode != 0:
        return result.returncode
    status = graph_status(args.root_id, roots)
    print(json.dumps(status, sort_keys=True))
    return 0 if status["state"] == "ready" else 1


if __name__ == "__main__":
    raise SystemExit(main())
