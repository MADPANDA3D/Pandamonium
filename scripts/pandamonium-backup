#!/usr/bin/env python3
"""pandamonium-backup — snapshot + restore of the data directory.

Backs up everything the app keeps under `data/`: the SQLite DB, the
Fernet key, JSON state files, RAG indexes, personal docs, attachments,
WhatsApp session, etc. Output is a gzip tarball — composable with cron
+ scp + s3cmd. The backup uses `sqlite3 .backup` for the DB so the
app can keep running during the snapshot.

    pandamonium-backup snapshot                       # → backups/YYYY-MM-DD-HHMMSS.tar.gz
    pandamonium-backup snapshot --out /mnt/nas/x.tgz
    pandamonium-backup list                           # entries in backups/
    pandamonium-backup restore PATH [--yes]           # overwrite current data/ from a tarball
    pandamonium-backup verify PATH                    # tarball integrity check (no extract)

Restore is destructive: it overwrites `data/` in place. Always pass
`--yes` so a typo can't nuke your live state.
"""

from __future__ import annotations

import os
import sys
sys.path.insert(0, os.path.join(os.path.dirname(__file__), "_lib"))
from cli import quiet_logs, emit, fail, common_parser, run, REPO_ROOT as _REPO_ROOT
quiet_logs()

import argparse
import hashlib
import io
import json
import logging
import os
import shutil
import sqlite3
import stat
import subprocess
import sys
import tarfile
import tempfile
from datetime import datetime, timezone
from pathlib import Path, PurePosixPath

from src.backup_archive import (
    BACKUP_MANIFEST_NAME,
    BACKUP_MANIFEST_NAMES,
    BACKUP_SCHEMA_V2,
    BackupArchiveError,
    backup_inventory_summary,
    build_backup_inventory,
    read_backup_manifest,
    validate_backup_members,
    verify_backup_inventory,
)

_DATA_DIR = Path(
    os.getenv("PANDAMONIUM_DATA_DIR")
    or os.getenv("ODYSSEUS_DATA_DIR")
    or (_REPO_ROOT / "data")
).resolve()
_BACKUP_DIR = _REPO_ROOT / "backups"
_MANIFEST_NAME = BACKUP_MANIFEST_NAME

# Stuff inside data/ that we explicitly skip — anything we can re-derive
# from the SQLite DB + JSON state. Keeps the tarball small.
_SKIP_PATTERNS = {
    "mail-attachments",     # cached IMAP attachment extractions
    "deep_research",        # research runs are large; back up explicitly via --include-research
    "personal_uploads",     # uploaded files; usually wanted, included by default actually
}


def _sqlite_safe_copy(src: Path, dst: Path) -> None:
    """Use SQLite's `.backup` API instead of a file copy so a write
    in-flight doesn't corrupt the snapshot. Falls back to plain copy
    if the file isn't a SQLite DB."""
    try:
        src_conn = sqlite3.connect(str(src))
        dst_conn = sqlite3.connect(str(dst))
        with dst_conn:
            src_conn.backup(dst_conn)
        src_conn.close()
        dst_conn.close()
    except Exception:
        # Not a SQLite DB or backup unsupported — fall back.
        dst.write_bytes(src.read_bytes())


def _reject_output_inside_data(out_path: Path) -> None:
    try:
        resolved = out_path.resolve()
        data_root = _DATA_DIR.resolve()
        resolved.relative_to(data_root)
    except ValueError:
        return
    fail("backup output path must be outside data/")


def _source_version() -> str:
    revision_file = _REPO_ROOT / "SOURCE_REVISION"
    try:
        revision = revision_file.read_text(encoding="utf-8").strip()
        if revision:
            return revision[:80]
    except OSError:
        pass
    try:
        result = subprocess.run(
            ["git", "rev-parse", "HEAD"], cwd=_REPO_ROOT,
            capture_output=True, text=True, timeout=2, check=False,
        )
        return result.stdout.strip()[:80] if result.returncode == 0 else "unknown"
    except Exception:
        return "unknown"


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _backup_manifest(args, inventory: dict) -> dict:
    exclusions = []
    if not args.include_research:
        exclusions.append("data/deep_research")
    if not args.include_attachments:
        exclusions.append("data/mail-attachments")
    return {
        "schema": BACKUP_SCHEMA_V2,
        "created_at": datetime.now(timezone.utc).isoformat(),
        "source_version": _source_version(),
        "scope": "pandamonium canonical data directory",
        "exclusions": exclusions,
        "external_vectors": {
            "docker_chromadb": (
                "separate volume; back up separately or rebuild from canonical sources"
            ),
            "qdrant": (
                "external projection; back up separately or rebuild from canonical "
                "memories/documents"
            ),
        },
        "integrity": {"algorithm": "sha256", "verified": False},
        "inventory": inventory,
        "restoration_procedure": "scripts/pandamonium-backup restore <archive> --yes",
    }


def _read_manifest(tar, members) -> dict:
    try:
        return read_backup_manifest(tar, members)
    except BackupArchiveError as exc:
        fail(str(exc))


def _verify_manifest_inventory(tar, members, manifest) -> dict:
    try:
        return verify_backup_inventory(tar, members, manifest)
    except BackupArchiveError as exc:
        fail(str(exc))


def _public_manifest(manifest: dict) -> dict:
    """Do not print protected archive paths while reporting proof."""
    public = dict(manifest)
    if "inventory" in public:
        public["inventory"] = backup_inventory_summary(public["inventory"])
    return public


class _DigestingReader:
    def __init__(self, source):
        self.source = source
        self.digest = hashlib.sha256()
        self.bytes_read = 0

    def read(self, size=-1):
        chunk = self.source.read(size)
        self.digest.update(chunk)
        self.bytes_read += len(chunk)
        return chunk


def _archive_path(path: Path) -> str:
    return (Path("data") / path.relative_to(_DATA_DIR)).as_posix()


def _materialized_symlink_target(path: Path) -> tuple[Path, os.stat_result]:
    """Resolve one non-chained symlink to a regular file strictly in data/."""
    archive_path = _archive_path(path)
    try:
        data_root = _DATA_DIR.resolve(strict=True)
        link_value = path.readlink()
    except OSError:
        fail(f"refusing dangling data symlink: {archive_path!r}")
    candidate = link_value if link_value.is_absolute() else path.parent / link_value
    lexical_target = Path(os.path.abspath(candidate))
    try:
        relative = lexical_target.relative_to(data_root)
    except ValueError:
        fail(f"refusing data symlink outside data/: {archive_path!r}")
    if not relative.parts:
        fail(f"refusing data symlink to a directory: {archive_path!r}")

    current = data_root
    metadata = None
    for index, part in enumerate(relative.parts):
        current = current / part
        try:
            metadata = current.lstat()
        except OSError:
            fail(f"refusing dangling data symlink: {archive_path!r}")
        if stat.S_ISLNK(metadata.st_mode):
            fail(f"refusing chained data symlink: {archive_path!r}")
        if index < len(relative.parts) - 1 and not stat.S_ISDIR(metadata.st_mode):
            fail(f"refusing dangling data symlink: {archive_path!r}")

    if metadata is None or stat.S_ISDIR(metadata.st_mode):
        fail(f"refusing data symlink to a directory: {archive_path!r}")
    if not stat.S_ISREG(metadata.st_mode):
        fail(f"refusing data symlink to a special file: {archive_path!r}")
    try:
        resolved = lexical_target.resolve(strict=True)
        resolved.relative_to(data_root)
    except (OSError, ValueError):
        fail(f"refusing data symlink outside data/: {archive_path!r}")
    if resolved != lexical_target:
        fail(f"refusing chained data symlink: {archive_path!r}")
    return resolved, metadata


def _add_regular_member(
    tar: tarfile.TarFile,
    source: Path,
    archive_path: str,
    *,
    source_kind: str,
    expected: os.stat_result | None = None,
) -> dict:
    """Add one stable regular-file descriptor and return its exact digest."""
    try:
        expected = expected or source.lstat()
        flags = (
            os.O_RDONLY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0)
        )
        descriptor = os.open(source, flags)
    except OSError as exc:
        fail(f"could not read backup member {archive_path!r}: {exc}")
    try:
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode)
            or (opened.st_dev, opened.st_ino) != (expected.st_dev, expected.st_ino)
        ):
            fail(f"backup member changed while opening: {archive_path!r}")
        info = tarfile.TarInfo(archive_path)
        info.size = opened.st_size
        info.mode = stat.S_IMODE(opened.st_mode)
        info.mtime = int(opened.st_mtime)
        info.uid = opened.st_uid
        info.gid = opened.st_gid
        with os.fdopen(descriptor, "rb") as handle:
            descriptor = -1
            reader = _DigestingReader(handle)
            tar.addfile(info, reader)
        if reader.bytes_read != info.size:
            fail(f"backup member changed while reading: {archive_path!r}")
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    return {
        "path": archive_path,
        "size": info.size,
        "sha256": reader.digest.hexdigest(),
        "source": source_kind,
    }


def _write_verification_sidecar(path: Path, proof: dict) -> bool:
    sidecar = Path(str(path) + ".verified.json")
    tmp = Path(str(sidecar) + f".tmp.{os.getpid()}")
    try:
        tmp.write_text(json.dumps(proof, indent=2), encoding="utf-8")
        os.replace(tmp, sidecar)
        return True
    except OSError:
        try:
            tmp.unlink(missing_ok=True)
        except OSError:
            pass
        return False


def cmd_snapshot(args):
    """Write a tar.gz of the entire data/ directory.

    SQLite databases are dumped via .backup() into a temp file before
    being added to the tar, so a running web app can't corrupt the
    snapshot. Everything else is copied as-is."""
    if not _DATA_DIR.is_dir():
        fail(f"no data dir at {_DATA_DIR}")
    _BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    out_path = Path(args.out) if args.out else (
        _BACKUP_DIR / f"pandamonium-backup-{datetime.now().strftime('%Y%m%d-%H%M%S')}.tar.gz"
    )
    _reject_output_inside_data(out_path)
    out_path.parent.mkdir(parents=True, exist_ok=True)

    sqlite_dbs = [
        p
        for p in _DATA_DIR.rglob("*.db")
        if p.is_file() and not p.is_symlink()
    ]
    inventory_entries = []
    with tempfile.TemporaryDirectory() as tmp_str:
        tmp = Path(tmp_str)
        # Snapshot SQLite DBs to the temp dir first.
        db_map: dict[Path, Path] = {}
        for db in sqlite_dbs:
            rel = db.relative_to(_DATA_DIR)
            staged = tmp / rel
            staged.parent.mkdir(parents=True, exist_ok=True)
            _sqlite_safe_copy(db, staged)
            db_map[db] = staged

        descriptor, temporary_name = tempfile.mkstemp(
            dir=out_path.parent, prefix=f".{out_path.name}.tmp-"
        )
        os.close(descriptor)
        temporary_archive = Path(temporary_name)
        try:
            with tarfile.open(temporary_archive, "w:gz") as tar:
                tar.add(_DATA_DIR, arcname="data", recursive=False)
                for p in sorted(_DATA_DIR.rglob("*")):
                    rel = Path("data") / p.relative_to(_DATA_DIR)
                    archive_path = rel.as_posix()
                    if archive_path in BACKUP_MANIFEST_NAMES:
                        continue
                    # Skip user-asked-to-skip categories.
                    if not args.include_research and "deep_research" in rel.parts:
                        continue
                    if not args.include_attachments and "mail-attachments" in rel.parts:
                        continue
                    if p.is_symlink():
                        target, target_metadata = _materialized_symlink_target(p)
                        source = db_map.get(target, target)
                        expected = (
                            source.lstat() if source != target else target_metadata
                        )
                        inventory_entries.append(
                            _add_regular_member(
                                tar,
                                source,
                                archive_path,
                                source_kind="materialized_internal_file_symlink",
                                expected=expected,
                            )
                        )
                        continue
                    if p.is_dir():
                        tar.add(p, arcname=archive_path, recursive=False)
                        continue
                    if not p.is_file():
                        continue
                    # Substitute SQLite snapshots for the live files.
                    source = db_map.get(p, p)
                    inventory_entries.append(
                        _add_regular_member(
                            tar, source, archive_path, source_kind="file"
                        )
                    )

                inventory = build_backup_inventory(inventory_entries)
                manifest = _backup_manifest(args, inventory)
                manifest_bytes = json.dumps(manifest, indent=2).encode("utf-8")
                manifest_info = tarfile.TarInfo(_MANIFEST_NAME)
                manifest_info.size = len(manifest_bytes)
                manifest_info.mode = 0o600
                manifest_info.mtime = int(datetime.now(timezone.utc).timestamp())
                tar.addfile(manifest_info, io.BytesIO(manifest_bytes))
            temporary_archive.chmod(0o600)
            os.replace(temporary_archive, out_path)
        finally:
            temporary_archive.unlink(missing_ok=True)

    digest = _sha256(out_path)
    files_added = len(inventory_entries) + 1
    total_bytes = inventory["total_bytes"] + len(manifest_bytes)
    emit({
        "ok": True,
        "schema": manifest["schema"],
        "path": str(out_path),
        "created_at": manifest["created_at"],
        "source_version": manifest["source_version"],
        "scope": manifest["scope"],
        "exclusions": manifest["exclusions"],
        "files": files_added,
        "uncompressed_bytes": total_bytes,
        "compressed_bytes": out_path.stat().st_size,
        "ratio": round(out_path.stat().st_size / max(total_bytes, 1), 4),
        "included_research": bool(args.include_research),
        "included_attachments": bool(args.include_attachments),
        "integrity": {"algorithm": "sha256", "sha256": digest, "verified": False},
        "inventory": backup_inventory_summary(inventory),
        "restoration_procedure": manifest["restoration_procedure"],
    }, args)


def cmd_list(args):
    """List entries in `backups/`. Most recent first."""
    if not _BACKUP_DIR.is_dir():
        emit([], args)
        return
    entries = []
    for p in _BACKUP_DIR.iterdir():
        entry = _backup_entry(p)
        if entry is not None:
            entries.append(entry)
    entries.sort(key=lambda entry: entry["_mtime"], reverse=True)
    for entry in entries:
        entry.pop("_mtime", None)
    emit(entries, args)


def _backup_entry(p):
    try:
        if not p.is_file():
            return None
        st = p.stat()
    except OSError:
        return None
    return {
        "path": str(p),
        "name": p.name,
        "bytes": st.st_size,
        "modified": datetime.fromtimestamp(st.st_mtime).isoformat(),
        "_mtime": st.st_mtime,
    }


def cmd_verify(args):
    """Open the tarball read-only and walk its members — confirms
    integrity without extracting anything."""
    path = Path(args.path)
    if not path.exists():
        fail(f"no file at {path}")
    try:
        with tarfile.open(path, "r:gz") as tar:
            members = tar.getmembers()
            _validate_restore_members(members)
            manifest = _read_manifest(tar, members)
            inventory = _verify_manifest_inventory(tar, members, manifest)
    except (tarfile.TarError, OSError) as e:
        fail(f"tarball is corrupt: {e}")
    proof = {
        "ok": True,
        "path": str(path),
        "sha256": _sha256(path),
        "verified_at": datetime.now(timezone.utc).isoformat(),
        "members": len(members),
        "first": members[0].name if members else None,
        "last": members[-1].name if members else None,
        "manifest": _public_manifest(manifest),
        "inventory": inventory,
    }
    proof["proof_recorded"] = _write_verification_sidecar(path, proof)
    emit(proof, args)


def _validate_restore_members(members):
    """Reject archive entries that can escape data/ during restore."""
    try:
        validate_backup_members(members)
    except BackupArchiveError as exc:
        fail(f"refusing tarball: {exc}")


def _extract_restore_members(
    tar,
    members,
    root: Path,
    owner: tuple[int, int] | None = None,
    root_mode: int | None = None,
) -> None:
    """Extract only regular files/directories after validation."""
    directories = []
    for m in members:
        target = root.joinpath(*PurePosixPath(m.name).parts)
        if m.isdir():
            target.mkdir(parents=True, mode=0o700, exist_ok=True)
            directories.append((target, m))
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        src = tar.extractfile(m)
        if src is None:
            fail(f"extract failed: could not read {m.name!r}")
        with src, open(target, "wb") as dst:
            shutil.copyfileobj(src, dst)
        target.chmod((m.mode & 0o777) or 0o600)
        if os.geteuid() == 0 and owner is not None:
            os.chown(target, *owner)
    for target, member in reversed(directories):
        # A malformed/legacy archive can describe a directory with a regular
        # file mode. Always retain owner traversal so restored content remains
        # reachable while preserving the archive's other permission bits.
        target.chmod(((member.mode & 0o777) or 0o755) | 0o700)
        if os.geteuid() == 0 and owner is not None:
            os.chown(target, *owner)
    data_root = root / "data"
    if data_root.is_dir():
        for directory in (item for item in data_root.rglob("*") if item.is_dir()):
            if os.geteuid() == 0 and owner is not None:
                os.chown(directory, *owner)
        if root_mode is not None:
            data_root.chmod((root_mode & 0o777) | 0o700)
        if os.geteuid() == 0 and owner is not None:
            os.chown(data_root, *owner)


def cmd_restore(args):
    """Overwrite `data/` from a tarball. Destructive; requires --yes."""
    path = Path(args.path)
    if not path.exists():
        fail(f"no file at {path}")
    if not args.yes:
        fail("restore is destructive — pass --yes to confirm overwriting data/")
    # Sanity check: tarball entries must all be safe, regular files/dirs under
    # `data/`. Avoid extractall() so symlink/hardlink entries can't redirect a
    # later write outside the repo.
    stash = None
    owner = None
    root_mode = None
    if os.geteuid() == 0 and _DATA_DIR.exists():
        data_stat = _DATA_DIR.stat()
        owner = (data_stat.st_uid, data_stat.st_gid)
        root_mode = data_stat.st_mode
    with tarfile.open(path, "r:gz") as tar:
        members = tar.getmembers()
        _validate_restore_members(members)
        manifest = _read_manifest(tar, members)
        inventory = _verify_manifest_inventory(tar, members, manifest)
        # Extract beside the configured data directory, then swap on the same
        # filesystem. This preserves external native-install data roots too.
        with tempfile.TemporaryDirectory(dir=_DATA_DIR.parent) as tmp:
            stage = Path(tmp)
            try:
                _extract_restore_members(tar, members, stage, owner, root_mode)
                if _DATA_DIR.exists() or _DATA_DIR.is_symlink():
                    stash = _DATA_DIR.with_name(
                        f"{_DATA_DIR.name}.before-restore-"
                        f"{datetime.now().strftime('%Y%m%d-%H%M%S')}-{os.getpid()}"
                    )
                    os.rename(_DATA_DIR, stash)
                os.replace(stage / "data", _DATA_DIR)
            except Exception as e:
                if stash and stash.exists() and not _DATA_DIR.exists():
                    os.rename(stash, _DATA_DIR)
                fail(f"extract failed: {e}")
    emit({
        "ok": True,
        "restored_from": str(path),
        "previous_data_stashed_at": str(stash) if stash else None,
        "manifest": _public_manifest(manifest),
        "inventory": inventory,
        "acceptance": {
            "data_directory_present": _DATA_DIR.is_dir(),
            "manifest_readable": bool(manifest),
            "inventory_verified": bool(inventory.get("verified")),
            "previous_state_recoverable": bool(stash),
        },
    }, args)


def _build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--pretty", action="store_true")
    p = argparse.ArgumentParser(prog="pandamonium-backup", parents=[common])
    sub = p.add_subparsers(dest="cmd", required=True)

    ps = sub.add_parser("snapshot", parents=[common])
    ps.add_argument("--out", help="output path (default: backups/<timestamp>.tar.gz)")
    ps.add_argument("--include-research", action="store_true",
                    help="include data/deep_research/ (skipped by default; large)")
    ps.add_argument("--include-attachments", action="store_true",
                    help="include data/mail-attachments/ (skipped by default; re-derivable)")
    ps.set_defaults(func=cmd_snapshot)

    pl = sub.add_parser("list", parents=[common])
    pl.set_defaults(func=cmd_list)

    pv = sub.add_parser("verify", parents=[common])
    pv.add_argument("path")
    pv.set_defaults(func=cmd_verify)

    pr = sub.add_parser("restore", parents=[common])
    pr.add_argument("path")
    pr.add_argument("--yes", action="store_true",
                    help="confirm overwriting current data/")
    pr.set_defaults(func=cmd_restore)

    return p


if __name__ == "__main__":
    sys.exit(run(_build_parser()))
