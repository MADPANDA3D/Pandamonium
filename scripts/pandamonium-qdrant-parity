#!/usr/bin/env python3
"""Compare canonical Chroma memory results with the read-disabled Qdrant shadow."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from core.constants import DATA_DIR  # noqa: E402
from src.memory_vector import MemoryVectorStore  # noqa: E402
from src.qdrant_parity import memory_projection_parity  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--owner", required=True)
    parser.add_argument("--query", action="append", required=True)
    parser.add_argument("--limit", type=int, default=5)
    args = parser.parse_args()
    store = MemoryVectorStore(str(DATA_DIR))
    report = memory_projection_parity(
        store,
        owner=args.owner,
        queries=args.query,
        limit=args.limit,
    )
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0 if report["passed"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
