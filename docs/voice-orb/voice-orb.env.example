# Copy only the values you need into the root .env file. Never commit secrets.

# Voice uses the current/default Odysseus model when both overrides are empty.
# ODYSSEUS_VOICE_ENDPOINT_ID=
# ODYSSEUS_VOICE_MODEL=
ODYSSEUS_VOICE_PERSONA=Odysseus

# Optional fixed read-only workers. All are disabled by default.
ODYSSEUS_PC_CODEX_ENABLED=false
ODYSSEUS_PC_CODEX_URL=http://127.0.0.1:8040
ODYSSEUS_AGENT_BRIDGE_TOKEN_FILE=/run/secrets/odysseus-pc-codex-token

ODYSSEUS_HERMES_ENABLED=false
ODYSSEUS_HERMES_URL=http://127.0.0.1:8642
ODYSSEUS_HERMES_TOKEN_FILE=/run/secrets/odysseus-hermes-token

ODYSSEUS_VPS_CODEX_ENABLED=false
ODYSSEUS_VPS_CODEX_URL=http://127.0.0.1:8650
ODYSSEUS_VPS_WORKER_TOKEN_FILE=/run/secrets/odysseus-vps-codex-token
