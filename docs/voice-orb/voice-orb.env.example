# Copy only the values you need into the root .env file. Never commit secrets.

# Voice uses the current/default Pandamonium model when both overrides are empty.
# PANDAMONIUM_VOICE_ENDPOINT_ID=
# PANDAMONIUM_VOICE_MODEL=
PANDAMONIUM_VOICE_PERSONA=Pandamonium

# Optional fixed read-only workers. All are disabled by default.
PANDAMONIUM_PC_CODEX_ENABLED=false
PANDAMONIUM_PC_CODEX_URL=http://127.0.0.1:8040
PANDAMONIUM_AGENT_BRIDGE_TOKEN_FILE=/run/secrets/pandamonium-pc-codex-token

PANDAMONIUM_HERMES_ENABLED=false
PANDAMONIUM_HERMES_URL=http://127.0.0.1:8642
PANDAMONIUM_HERMES_TOKEN_FILE=/run/secrets/pandamonium-hermes-token

PANDAMONIUM_VPS_CODEX_ENABLED=false
PANDAMONIUM_VPS_CODEX_URL=http://127.0.0.1:8650
PANDAMONIUM_VPS_WORKER_TOKEN_FILE=/run/secrets/pandamonium-vps-codex-token
